# Copia in .env (non committare).

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Dettagli annunci: da PostgreSQL (tabella gestim_listings) — consigliato
LISTING_SOURCE=database
# Opzione A — URL unico:
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
# Con DATABASE_URL su cloud (Render, Scaleway, ecc.): se vedi errore PostgreSQL tipo
# "self-signed certificate" / DEPTH_ZERO_SELF_SIGNED_CERT, imposta anche:
# DB_SSL=true
# Meglio ancora la CA del provider come TLS_CERT=(PEM) e senza disabilitare la verifica.
# Opzione B — variabili separate (es. Render / Scaleway), senza URL:
# DB_HOST=
# DB_PORT=5432
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# DB_SSL=true
# TLS_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Solo se usi ancora l'API HTTP invece del DB:
# LISTING_SOURCE=api
# GESTIM_API_BASE_URL=https://tuo-backend.example.com

# Google — una delle due:
# Esempio locale (file nella root del progetto; non committare il JSON):
# GOOGLE_APPLICATION_CREDENTIALS=./megaron-493608-9fc8ca550180.json
GOOGLE_APPLICATION_CREDENTIALS=/percorso/service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# --- Mappa zona → nome tab (scegli UNA tra raw hardcoded, foglio mapping o JSON) ---

# Opzione 0 (consigliata, allineata al test Python): raw tab-delimitato.
# Ogni riga: ZONA<TAB>FOGLIO, anche più coppie sulla stessa riga.
# ZONE_SHEET_MAPPING_RAW=BARBARICINA\tAG\tBORGHETTO\tEROS

# Opzione 1: tab "mapping" nello stesso file: col A = zona, col B = nome foglio destinazione (senza riga header)
MAPPING_SPREADSHEET_ID=1TeCxH0BRETny1P-3-Rf65_EYMly1YGvpibYZtnzpTT0
MAPPING_SHEET_NAME=mapping
# "contains" (default) oppure "equals"; allineato a `IMAP_ZONE_MATCH` del test Python
MAPPING_ZONE_MATCH=contains
# DEFAULT_SPREADSHEET_ID opzionale: default = MAPPING_SPREADSHEET_ID

# Opzione 2: regole in JSON (allora DEFAULT_SPREADSHEET_ID è obbligatorio se non usi MAPPING_SPREADSHEET_ID)
# DEFAULT_SPREADSHEET_ID=your_default_spreadsheet_id
# ZONE_SHEET_MAP_JSON=[{"name":"Prati","pattern":"Prati","match":"contains","spreadsheetId":"ID","sheetTitle":"Prati"}]

DEFAULT_SHEET_TITLE=AG
NO_ID_FOUND_SHEET_TITLE=no-id-trovato
# Email con una di queste parole viene scartata (separate da virgola)
BLOCKED_EMAIL_SUBSTRINGS=immobiliare,noreply,no-reply,idealista,gruppoinsieme,mailer-daemon

# EXTRA_ID_REGEX=GESTIM-([A-Z0-9]{6,})

# --- Risposta automatica lead (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# Finche' siamo in test, tutte le risposte vanno qui (non al cliente reale)
LEAD_REPLY_FORCE_TO=simoncinidiego10@gmail.com

# Contatto usato quando il lead finisce nel foglio AG
AGENCY_REPLY_PHONE=+390000000000
AGENCY_REPLY_EMAIL=agenzia@example.com

# Mappa contatti agenti per nome sheet.
# Esempio:
# AGENT_REPLY_CONTACTS_JSON={"EROS":{"phone":"+390111111111","email":"eros@megaronimmobiliare.it"},"DAVIDE":{"phone":"+390222222222","email":"davide@megaronimmobiliare.it"}}
AGENT_REPLY_CONTACTS_JSON={}

# Placeholder colonna A delle righe lead quando l'email è vuota.
# Default: "—". Per A vera-vera vuota: SHEET_PLACEHOLDER_EMPTY_LEAD_EMAIL=
# SHEET_PLACEHOLDER_EMPTY_LEAD_EMAIL=—

# --- Worker IMAP Aruba (npm run start:worker), allineato a test_imap_aruba.py ---
# IMAP_EMAIL=megaron@megaronimmobiliare.it
# IMAP_PASSWORD=
# IMAP_SERVER=imaps.aruba.it
# IMAP_PORT=993
# IMAP_SECURE=true
# Finestra IMAP in ore (default 1 = ultima ora)
# IMAP_LOOKBACK_HOURS=1
# Numero massimo di messaggi processati per ciclo (default 200)
# IMAP_FETCH_LIMIT=200
# WORKER_POLL_INTERVAL_MINUTES=60
